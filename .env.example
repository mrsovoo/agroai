# =============================================================================
# AgroAI Core - example configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and edit. Every value has a safe local default and NO API key
# is ever required: AgroAI is offline-first and does not call cloud services.
# =============================================================================

# --- General ----------------------------------------------------------------
# Project root. Defaults to the directory containing pyproject.toml.
# AGROAI_HOME=/absolute/path/to/agroai
AGROAI_LOG_LEVEL=INFO
# Default answer language: uz (Uzbek), ru (Russian) or en (English).
AGROAI_DEFAULT_LANGUAGE=uz

# --- Knowledge base ---------------------------------------------------------
# Root directory containing the category folders (crops, livestock, ...).
AGROAI_KNOWLEDGE_DIR=knowledge

# --- Storage ----------------------------------------------------------------
# Local SQLite database used for metadata, chunks and full-text search.
AGROAI_DATABASE_PATH=data/database/agroai.db
# Directory reserved for future vector indexes (FAISS/Qdrant/Chroma/...).
AGROAI_VECTOR_DB_PATH=data/indexes
# Where the ingestion pipeline copies/collects source documents.
AGROAI_DOCUMENTS_DIR=data/documents
# Where local model files (GGUF) are looked for. Nothing is downloaded here.
AGROAI_MODELS_DIR=models
# Where exported fine-tuning datasets (JSONL) are written.
AGROAI_DATASETS_DIR=datasets

# --- LLM provider -----------------------------------------------------------
# Provider abstraction: local | ollama | llamacpp | mock
# "local" + no model configured = AgroAI reports "not configured" (never fakes).
AGROAI_LLM_PROVIDER=local
# Model name (alias: AGROAI_LLM_MODEL), e.g. an Ollama model "llama3.1:8b".
AGROAI_LOCAL_MODEL=
# Path to a local GGUF model file (alias: AGROAI_LOCAL_MODEL_PATH).
AGROAI_MODEL_PATH=
# Base URL for a local inference server (Ollama/llama.cpp server).
AGROAI_LLM_ENDPOINT=http://127.0.0.1:11434
# Hard cap on generated tokens.
AGROAI_LLM_MAX_TOKENS=512
AGROAI_LLM_TEMPERATURE=0.2

# --- Embeddings provider ----------------------------------------------------
# Interface only in Phase 1: none | local | hf
AGROAI_EMBEDDING_PROVIDER=none
# Path/name of a local embedding model (GGUF / sentence-transformers directory).
AGROAI_EMBEDDING_MODEL=
AGROAI_EMBEDDING_DIMENSIONS=384

# --- Retrieval --------------------------------------------------------------
# Backend used by the retriever: sqlite (working now) | vector (needs embeddings).
AGROAI_RETRIEVAL_BACKEND=sqlite
# Vector store: none (default) | memory (real in-memory cosine store).
# faiss/qdrant/chroma/sqlite-vec are reported as not implemented, never faked.
AGROAI_VECTOR_STORE_BACKEND=none

# --- Safety -----------------------------------------------------------------
# strict=true raises agrochemical questions to high risk. Recommended.
AGROAI_SAFETY_STRICT=true

# --- Knowledge updates ------------------------------------------------------
# Automatic updates from trusted sources: none (only option). Core never
# reaches the network on its own; the knowledge base changes only via ingest.
AGROAI_UPDATER_PROVIDER=none

# --- Ingestion --------------------------------------------------------------
AGROAI_CHUNK_SIZE=800
AGROAI_CHUNK_OVERLAP=120
# Skip a document if a document with the same content hash already exists.
AGROAI_DEDUPLICATE=true

# --- Product layer: API / Web / Telegram ------------------------------------
AGROAI_API_HOST=127.0.0.1
AGROAI_API_PORT=8080
# Comma-separated origins allowed by CORS (Web dev client).
AGROAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AGROAI_WEB_URL=http://localhost:3000
# Telegram bot token from @BotFather. NEVER commit the real token.
AGROAI_TELEGRAM_BOT_TOKEN=
AGROAI_TELEGRAM_ENABLED=false
AGROAI_TELEGRAM_MODE=polling
# Super admin panel (HTTP): password is required when enabled.
AGROAI_ADMIN_PASSWORD=
